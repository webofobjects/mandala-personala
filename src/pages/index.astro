---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CeEste from '../components/CeEste.astro';
import Galerie from '../components/Galerie.astro';
import Beneficii from '../components/Beneficii.astro';
import Cadou from '../components/Cadou.astro';
import Simboluri from '../components/Simboluri.astro';
import DataNasterii from '../components/DataNasterii.astro';
import CumLucrez from '../components/CumLucrez.astro';
import Pret from '../components/Pret.astro';
import Intrebari from '../components/Intrebari.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

import { getImage } from 'astro:assets';
import { meta, intrebari } from '../data/continut';
import { site } from '../data/site';
import { lucrare } from '../data/lucrari';
import { plain } from '../lib/text';

// Câteva lucrări reale, ca imagini ale produsului în rezultatele căutării.
const imaginiProdus = await Promise.all(
  ['trandafir-pe-albastru', 'samanta-vietii-auriu-indigo', 'floarea-vietii-lotusi-roz', 'trandafir-in-inima'].map(async (slug) => {
    const img = await getImage({ src: lucrare(slug), width: 1200, format: 'jpg', quality: 82 });
    return new URL(img.src, site.url).href;
  }),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#site`,
      name: site.nume,
      alternateName: site.domeniu,
      url: `${site.url}/`,
      inLanguage: 'ro-RO',
      publisher: { '@id': `${site.url}/#organizatie` },
    },
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organizatie`,
      name: site.nume,
      url: site.url,
      logo: `${site.url}/icon-512.png`,
      email: site.email,
      telephone: site.telefonLink,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: site.telefonLink,
        email: site.email,
        contactType: 'customer service',
        availableLanguage: ['ro'],
        areaServed: 'RO',
      },
    },
    {
      '@type': 'Product',
      '@id': `${site.url}/#mandala-personala`,
      name: 'Mandala personalizată pictată manual pe pânză',
      description: meta.descriere,
      image: [...imaginiProdus, `${site.url}/og.jpg`],
      category: 'Tablouri pictate manual',
      brand: { '@id': `${site.url}/#organizatie` },
      offers: {
        '@type': 'Offer',
        price: site.pret,
        priceCurrency: 'RON',
        availability: 'https://schema.org/MadeToOrder',
        url: `${site.url}/#pret`,
        seller: { '@id': `${site.url}/#organizatie` },
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: intrebari.lista.map((q) => ({
        '@type': 'Question',
        name: plain(q.q),
        acceptedAnswer: { '@type': 'Answer', text: plain(q.a) },
      })),
    },
  ],
};
---

<Base title={meta.titlu} description={meta.descriere} jsonLd={jsonLd}>
  <Header />
  <main id="continut">
    <Hero />
    <CeEste />
    <Galerie />
    <Beneficii />
    <Cadou />
    <Simboluri />
    <DataNasterii />
    <CumLucrez />
    <Pret />
    <Intrebari />
    <Contact />
  </main>
  <Footer />
</Base>
