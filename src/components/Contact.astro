---
import DotTrail from './DotTrail.astro';
import { contact } from '../data/continut';
import { site, telHref, smsHref, mailtoHref } from '../data/site';
import { accent } from '../lib/text';
---

<section id="contact" class="border-t border-line bg-paper-2/60 py-20 lg:py-28" aria-labelledby="titlu-contact">
  <div class="wrap grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <h2 id="titlu-contact" class="text-title" set:html={accent(contact.titlu)} />
      <p class="mt-6 max-w-[32rem] text-lede text-ink-2" set:html={accent(contact.text)} />

      <div class="mt-10">
        <p class="font-display text-xl text-ink">{contact.listaTitlu}</p>
        <ul role="list" class="mt-5 grid gap-3">
          {
            contact.lista.map((item) => (
              <li class="flex items-baseline gap-4 text-ink-2">
                <DotTrail count={3} class="shrink-0" />
                <span set:html={accent(item)} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="grid content-start gap-5 lg:col-span-6 lg:pl-6">
      <div class="border border-line bg-paper p-7 sm:p-9">
        <p class="text-sm font-semibold tracking-wide text-gold-deep">{contact.telefonEticheta}</p>
        <a href={telHref} class="mt-3 block font-display text-[clamp(2.2rem,1.6rem+2.4vw,3.2rem)] leading-none tracking-[-0.02em] text-ink tabular-nums hover:text-indigo">
          {site.telefon}
        </a>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={telHref} class="btn btn-primary">{contact.sunaButon}</a>
          <a href={smsHref} class="btn btn-ghost md:hidden">{contact.smsButon}</a>
        </div>
      </div>

      <div class="border border-line bg-paper p-7 sm:p-9">
        <p class="text-sm font-semibold tracking-wide text-gold-deep">{contact.emailEticheta}</p>
        <a href={mailtoHref} class="mt-3 block font-display text-[clamp(1.45rem,1.1rem+1.4vw,2.1rem)] leading-tight break-all text-ink hover:text-indigo">
          {site.email}
        </a>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={mailtoHref} class="btn btn-primary">{contact.emailButon}</a>
          <button type="button" class="btn btn-ghost" data-copiaza={site.email} data-text-copiat={contact.copiat} data-text-copiaza={contact.copiaza}>
            {contact.copiaza}
          </button>
        </div>
        <p class="sr-only" aria-live="polite" data-mesaj-copiere></p>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copiaza]');
  const mesaj = document.querySelector<HTMLElement>('[data-mesaj-copiere]');
  btn?.addEventListener('click', async () => {
    const adresa = btn.dataset.copiaza ?? '';
    let text = btn.dataset.textCopiat ?? '';
    try {
      await navigator.clipboard.writeText(adresa);
    } catch {
      // dacă browserul nu permite copierea, arătăm adresa, ca să poată fi selectată
      text = adresa;
    }
    btn.textContent = text;
    if (mesaj) mesaj.textContent = text;
    setTimeout(() => {
      btn.textContent = btn.dataset.textCopiaza ?? '';
      if (mesaj) mesaj.textContent = '';
    }, 4000);
  });
</script>
