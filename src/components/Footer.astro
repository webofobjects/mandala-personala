---
import DotMark from './DotMark.astro';
import { nav, subsol } from '../data/continut';
import { site, telHref, mailtoHref } from '../data/site';

const azi = new Date();
const an = azi.getFullYear();
const actualizat = new Intl.DateTimeFormat('ro-RO', { day: 'numeric', month: 'long', year: 'numeric' }).format(azi);
---

<footer class="bg-night text-paper/75">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <a href="#continut" aria-label={`${site.nume}, începutul paginii`} class="inline-flex items-center gap-3 text-paper">
        <DotMark size={36} />
        <span class="font-display text-[1.4rem] leading-none">Mandala <span class="italic">personală</span></span>
      </a>
      <p class="mt-5 max-w-[24rem] text-[0.95rem] leading-relaxed">{subsol.text}</p>
    </div>

    <nav aria-label="Subsol" class="md:col-span-3">
      <ul role="list" class="grid gap-2 text-[0.95rem]">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-paper">
                {item.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:col-span-4">
      <p class="font-display text-lg text-gold-light italic">{subsol.comenziTitlu}</p>
      <p class="mt-3"><a href={telHref} class="text-xl text-paper tabular-nums hover:text-gold-light">{site.telefon}</a></p>
      <p class="mt-1"><a href={mailtoHref} class="[overflow-wrap:anywhere] text-paper hover:text-gold-light">{site.email.split('@')[0]}<wbr />@{site.email.split('@')[1]}</a></p>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-6 text-sm text-paper/55">
      <p>© {an} {site.nume} · {site.domeniu}</p>
      <p>{subsol.actualizat} {actualizat}</p>
    </div>
  </div>
</footer>
