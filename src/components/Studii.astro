---
// Ce spun studiile — un bloc informativ, separat de preț și de butoanele de comandă.
import { studii } from '../data/continut';
import { accent } from '../lib/text';
---

<section id="studii" class="py-20 lg:py-28" aria-labelledby="titlu-studii">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="titlu-studii" class="text-title" set:html={accent(studii.titlu)} />
      </div>
      <p class="max-w-[38rem] text-lede text-ink-2 lg:col-span-7 lg:pt-12" set:html={accent(studii.intro)} />
    </div>

    <ol role="list" class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        studii.lista.map((s, i) => (
          <li class="grid grid-cols-[2rem_1fr] gap-x-3 border-t border-line pt-6">
            <span class="font-display text-lg leading-snug text-gold-deep italic tabular-nums" aria-hidden="true">
              {i + 1}.
            </span>
            <div>
              <p class="text-ink" set:html={accent(s.text)} />
              <p class="mt-3 text-[0.82rem] leading-snug text-ink-2">
                <a href={s.url} class="link break-words" rel="noopener" target="_blank">
                  <span lang="en">{s.sursa}</span>
                  <span class="sr-only"> (se deschide într-o filă nouă)</span>
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="mt-14 max-w-[46rem] border-l-2 border-dotted border-gold pl-5 text-[0.95rem] text-ink-2" set:html={accent(studii.nota)} />
  </div>
</section>
