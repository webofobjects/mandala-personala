---
import { beneficii } from '../data/continut';
import { accent } from '../lib/text';
---

<section id="beneficii" class="py-20 lg:py-28" aria-labelledby="titlu-beneficii">
  <div class="wrap grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <h2 id="titlu-beneficii" class="text-title" set:html={accent(beneficii.titlu)} />
        <p class="mt-6 max-w-[30rem] text-lede text-ink-2" set:html={accent(beneficii.intro)} />
      </div>
    </div>

    <ol role="list" class="lg:col-span-7 lg:col-start-6 xl:col-span-6 xl:col-start-7">
      {
        beneficii.lista.map((b, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-t border-line py-8 first:border-t-0 first:pt-0 sm:grid-cols-[3.5rem_1fr]">
            <span class="font-display text-[1.6rem] leading-none text-gold-deep italic" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3 class="text-[1.55rem] leading-tight" set:html={accent(b.titlu)} />
              <p class="mt-3 max-w-[34rem] text-ink-2" set:html={accent(b.text)} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
